{
  "name": "social-agent",
  "version": "0.0.1",
  "description": "Headless social agent service (CLI + web dashboard) — extracted from PetGPT",
  "private": true,
  "type": "module",
  "module": "src/cli.tsx",
  "bin": {
    "social-agent": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "serve": "bun run src/server.ts",
    "build": "bun build src/cli.tsx --compile --target=bun-darwin-arm64 --outfile=dist/social-agent",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
